# Copie para .env.local e preencha os valores reais (nunca commitar .env.local).

# Connection string COM POOLER do Supabase (não a conexão direta usada pelos
# workflows do GitHub Actions) — painel Supabase -> Settings -> Database ->
# Connection pooling -> modo "Transaction", porta 6543.
# Formato esperado: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL_POOLED=

# Senha única compartilhada pra acessar o painel (proteção simples via cookie,
# ver lib/auth.ts e proxy.ts) — escolha algo só seu, não precisa ser complexo.
PANEL_PASSWORD=
