# ==============================================================================
# .env.example — copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com suas credenciais reais) para lugar nenhum
# público — ele dá acesso à sua conta do Telegram.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) TELEGRAM USERBOT (Telethon) — lê o grupo privado de tips
#    Como obter API_ID/API_HASH: veja o passo a passo no README.md
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=coloque_seu_api_hash_aqui
TELEGRAM_SESSION_NAME=tennis_monitor_session

# Só necessário em produção (GitHub Actions) — deixe em branco pra uso
# local. Gere com "python generate_session_string.py" (veja README, seção
# "Deploy em produção"). Trate como senha: nunca cole em código ou lugar
# público, só no secret do GitHub Actions.
TELEGRAM_SESSION_STRING=

# Grupo/canal de origem das tips. Pode ser:
#   - o @username público do grupo (ex: meugrupo_tips),
#   - o ID numérico do grupo privado (ex: -1001234567890) — só funciona se
#     o grupo for permanente (mesmo ID todo dia), OU
#   - um PREFIXO do nome do grupo (ex: "Cansadão Apostas") — use isso quando
#     o grupo é recriado periodicamente com um sufixo variável no nome
#     (ex: "Cansadão Apostas 31/08", "Cansadão Apostas 01/09"): o listener
#     acha automaticamente o grupo mais recente com esse prefixo a cada
#     execução, sem precisar atualizar nada quando um grupo novo é liberado.
# Dica: rode "python listener.py --list-chats" (veja README) para conferir
# nomes/IDs exatos dos seus chats.
TELEGRAM_SOURCE_CHAT=Cansadão Apostas

# ------------------------------------------------------------------------------
# 2) TELEGRAM BOT API (notifier.py) — envia a notificação formatada para você
#    Como criar: fale com @BotFather no Telegram -> /newbot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenDoBotFather
# Seu chat_id pessoal (não é o mesmo do grupo!). Descubra falando com @userinfobot.
TELEGRAM_BOT_CHAT_ID=987654321

# ------------------------------------------------------------------------------
# 3) MOTOR DE OCR (extractor.py)
#    OCR_ENGINE = "easyocr"  -> 100% local, gratuito, sem limite de uso (mais lento na 1a vez).
#                                Bom pra uso local; em produção (GitHub Actions) baixa o
#                                modelo (~200MB) do zero a cada execução — use "gemini" lá.
#    OCR_ENGINE = "gemini"   -> usa o Free Tier da API Gemini (mais preciso, precisa de internet).
#                                Recomendado em produção — ver README, "Deploy em produção".
# ------------------------------------------------------------------------------
OCR_ENGINE=easyocr

# Necessário apenas se OCR_ENGINE=gemini. Gere grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4) BANCO DE DADOS / ARQUIVOS
# ------------------------------------------------------------------------------
# Obrigatório (local e produção): connection string do Neon (Postgres
# gratuito). Crie um projeto em https://neon.tech e copie a
# "Connection string" do painel — algo como:
#   postgresql://usuario:senha@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

MEDIA_DIR=media

# ------------------------------------------------------------------------------
# 5) MATCHER — descoberta do confronto oficial (SofaScore) + casas de apostas
# ------------------------------------------------------------------------------
# Similaridade mínima (0-100) para considerar dois nomes de jogadores "iguais"
SUPERBET_FUZZY_THRESHOLD=80
# Rodar o navegador headless (sem abrir janela). Deixe "true" em produção;
# mude pra "false" quando for calibrar seletores e quiser ver o navegador.
PLAYWRIGHT_HEADLESS=true

# Quais casas de apostas tentar (nomes separados por vírgula, sem espaço).
# Cada uma vira um botão na notificação/dashboard. Ver bookmakers/ no código.
BOOKMAKERS=superbet,betano,bet365

# Confirmado ao vivo (celular, rede no Brasil) — domínio real é .bet.br, e o
# filtro de dia usa a palavra "hoje" (não uma data ISO). Ver bookmakers/superbet.py.
SUPERBET_BASE_URL=https://superbet.bet.br/apostas/tenis

BETANO_BASE_URL=https://betano.bet.br
# AINDA NÃO CONFIRMADO — abra a Betano PELO NAVEGADOR (não pelo app; o link
# de "compartilhar" do app não serve, é uma splash page de deep-link) e
# substitua pela URL real da seção de tênis. Ver bookmakers/betano.py.
BETANO_TENNIS_PATH=/sport/tenis/

# Confirmado ao vivo, mas é uma rota com hash interno da conta que abriu —
# pode não ser estável entre sessões/contas. Ver bookmakers/bet365.py.
BET365_BASE_URL=https://www.bet365.bet.br
BET365_TENNIS_PATH=/?lng=33#/AS/B13/K%5E5/

# ------------------------------------------------------------------------------
# 6) DIVERSOS
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Fuso horário usado para exibir/gravar os horários das partidas — use o
# fuso de referência dos torneios/tipsters do seu grupo, não necessariamente
# o seu próprio (ex: a maioria usa horário de Brasília mesmo se você mora
# em outro fuso do Brasil).
TIMEZONE=America/Sao_Paulo
